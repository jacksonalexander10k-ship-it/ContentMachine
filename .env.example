# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI API Key (for Whisper transcription and script segmentation)
OPENAI_API_KEY=

# fal.ai API Key (for Kling 3.0 Pro video generation with native audio)
# Get from https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: Default starting frame image URL
# If not set, users must upload a photo before generating videos.
DEFAULT_AVATAR_URL=

# Optional: Max concurrent fal.ai requests (default: 2)
FAL_MAX_CONCURRENT=2

# Optional: Webhook mode for production deployments
# Leave empty for polling mode (simpler, good for development).
# Set to your server's public HTTPS URL for webhook mode.
WEBHOOK_URL=
PORT=8443

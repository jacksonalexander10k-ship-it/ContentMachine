# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI API Key (for TTS and Whisper transcription)
OPENAI_API_KEY=

# Kling AI API credentials (from https://klingai.com/global/dev)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Optional: Default avatar image URL
# If not set, users must upload a photo before generating videos.
DEFAULT_AVATAR_URL=

# Optional: Max concurrent Kling API requests (default: 2)
KLING_MAX_CONCURRENT=2

# Optional: Webhook mode for production deployments
# Leave empty for polling mode (simpler, good for development).
# Set to your server's public HTTPS URL for webhook mode.
WEBHOOK_URL=
PORT=8443
